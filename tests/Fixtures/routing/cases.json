        {
            "name": "best-ranked location that has everything wins",
            "config": {
                "version": 1,
                "ranking": [
                    "L:wh",
                    "L:store"
                ],
                "prefer_local": null,
                "no_split": false,
                "constraints": []
            },
            "scenario": {
                "lines": [
                    {
                        "id": "1",
                        "title": "Mug",
                        "quantity": 2,
                        "tags": []
                    }
                ],
                "destination": {
                    "country_code": "US",
                    "province_code": "MN"
                },
                "locations": [
                    {
                        "id": "L:store",
                        "name": "Shop location",
                        "country_code": "US",
                        "province_code": "MN"
                    },
                    {
                        "id": "L:wh",
                        "name": "Lahore warehouse",
                        "country_code": "PK",
                        "province_code": "PB"
                    }
                ],
                "stock": {
                    "L:wh": {
                        "1": 5
                    },
                    "L:store": {
                        "1": 5
                    }
                }
            },
            "expected": {
                "outcome": "single",
                "shipments": [
                    {
                        "location": "L:wh",
                        "lines": [
                            "1"
                        ]
                    }
                ],
                "ranking": [
                    "L:wh",
                    "L:store"
                ],
                "reason_codes": [
                    "single_location"
                ],
                "eligible_by_line": {
                    "1": [
                        "L:wh",
                        "L:store"
                    ]
                }
            }
        },
